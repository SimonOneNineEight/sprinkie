# /etc/sprinkie/api.env — fill in and chmod 600.
#
# Direct connection (what the box uses — its network has IPv6, which
# Supabase's direct hosts require). If the ISP ever drops IPv6, switch to
# the session pooler string from the dashboard (Connect -> Session pooler):
# postgresql://postgres.tebfjmsmnhfeapbzytxy:PASSWORD@aws-0-us-west-2.pooler.supabase.com:5432/postgres
# (session mode, port 5432 — transaction mode breaks pgx's prepared statements).
DATABASE_URL=postgresql://postgres:DB_PASSWORD_HERE@db.tebfjmsmnhfeapbzytxy.supabase.co:5432/postgres
SUPABASE_JWKS_URL=https://tebfjmsmnhfeapbzytxy.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_URL=https://tebfjmsmnhfeapbzytxy.supabase.co/storage/v1
# Settings -> API keys -> create a secret key (sb_secret_...).
SUPABASE_SECRET_KEY=
PORT=8080
