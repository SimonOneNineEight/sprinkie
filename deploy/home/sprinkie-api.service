# /etc/systemd/system/sprinkie-api.service
[Unit]
Description=Sprinkie API
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/sprinkie/api
EnvironmentFile=/etc/sprinkie/api.env
Restart=always
RestartSec=3
User=sprinkie
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
