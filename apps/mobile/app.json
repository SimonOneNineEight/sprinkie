{
  "expo": {
    "name": "Sprinkie",
    "slug": "sprinkie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.simononenineeight.sprinkie",
      "usesAppleSignIn": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "zh_TW",
        "NSCameraUsageDescription": "拍照加入紀錄。",
        "NSPhotoLibraryUsageDescription": "從相簿選擇照片加入紀錄。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.372365049915-kubrrrce3c7hkaqptpk0eu1s0ohcccc2"
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": ["zh-Hant", "en"]
        }
      ]
    ]
  }
}
